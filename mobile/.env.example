# Copy to .env for local builds. Store/release builds must bake the same
# Web client in — customers never put these on the Pi. The phone POSTs them
# over LAN with the user's Google token (README §18).

# Android OAuth client (Google Cloud → Credentials → Application type: Android)
# Package: com.sinisterchiller.homesecurity
# Debug SHA-1 (expo run:android / android/app/debug.keystore):
#   5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Required Web client (Application type: Web application) — same pair the Pi
# uses to refresh Drive access after the phone is gone.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret

# Optional
# EXPO_PUBLIC_CLOUD_URL=https://your-ngrok.ngrok-free.app
# EXPO_PUBLIC_PI_URL=http://192.168.0.236:4000
